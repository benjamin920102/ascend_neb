/* NEB KEP1 consensus-safe Ascend C AIV kernel.
 * No torch, no floating point, no approximated INT4 arithmetic.
 * One Vector AI Core computes exactly ONE digest lane for ONE nonce.
 * The first release uses GM scalar GetValue as a portable correctness baseline.
 * It is intentionally NOT described as a high-throughput Cube kernel.
 * Every core writes an independent 64-byte cache line to avoid SetValue races.
 */
#include <cstdint>
#include "kernel_operator.h"
#include "acl/acl.h"

extern "C" __global__ __vector__ void neb_digest_kernel(
    GM_ADDR conv_gm, GM_ADDR fac_gm, GM_ADDR idx_gm, GM_ADDR out_gm,
    uint32_t sample_count, uint32_t attempts) {
    const uint32_t block = AscendC::GetBlockIdx();
    if (block >= attempts * 8u) return;
    const uint32_t attempt = block >> 3;
    const uint32_t lane = block & 7u;
    AscendC::GlobalTensor<int16_t> conv;
    AscendC::GlobalTensor<int8_t> fac;
    AscendC::GlobalTensor<uint32_t> indices;
    AscendC::GlobalTensor<uint32_t> output;
    conv.SetGlobalBuffer(reinterpret_cast<__gm__ int16_t*>(conv_gm), (uint64_t)sample_count*1360u);
    fac.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(fac_gm), (uint64_t)sample_count*834u);
    indices.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(idx_gm), (uint64_t)attempts*16u);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(out_gm), (uint64_t)attempts*8u*16u);
    const uint32_t nw[6]={40u,640u,40u,640u,24576u,64u};
    const uint32_t conv_off[4]={0u,40u,680u,720u};
    const uint32_t fc_in[2]={768u,32u};
    const uint32_t fc_out[2]={32u,2u};
    const uint32_t fac_off[2]={0u,800u};
    uint32_t samples[16];
    for (uint32_t s=0;s<16u;++s) samples[s]=indices.GetValue((uint64_t)attempt*16u+s);
    uint32_t acc=0;
    for(uint32_t layer=0;layer<6u;++layer) {
        const uint32_t base=7919u*(layer+1u);
        for(uint32_t f=lane;f<nw[layer];f+=8u) {
            int32_t g=0;
            if(layer<4u) {
                for(uint32_t s=0;s<16u;++s) {
                    const uint32_t idx=samples[s];
                    if (idx>=sample_count) continue; // Host validates all indices before launch.
                    g += (int32_t)conv.GetValue((uint64_t)idx*1360u+conv_off[layer]+f);
                }
            } else {
                const uint32_t d=layer-4u;
                const uint32_t o=f/fc_in[d];
                const uint32_t q=f%fc_in[d];
                for(uint32_t s=0;s<16u;++s) {
                    const uint32_t idx=samples[s];
                    if(idx>=sample_count) continue;
                    const uint64_t offset=(uint64_t)idx*834u+fac_off[d];
                    const int32_t err=(int32_t)fac.GetValue(offset+o);
                    const int32_t x=(int32_t)fac.GetValue(offset+fc_out[d]+q);
                    g += err*x;
                }
            }
            const int32_t c=g< -256 ? -256 : (g>256 ? 256 : g);
            acc += ((uint32_t)c) ^ (f+base);
        }
    }
    // 16 uint32 words = 64 bytes per core: cache-line isolated GM write.
    output.SetValue((uint64_t)block*16u, acc);
    // GlobalTensor::SetValue updates the scalar cache; force writeback for D2H.
    dcci(reinterpret_cast<__gm__ uint32_t*>(out_gm)+(uint64_t)block*16u,
         cache_line_t::SINGLE_CACHE_LINE, dcci_dst_t::CACHELINE_OUT);
}

extern "C" void neb_launch_digest(void* conv,void* fac,void* indices,void* output,
                                   uint32_t sample_count,uint32_t attempts,aclrtStream stream) {
    neb_digest_kernel<<<attempts*8u, nullptr, stream>>>(
      reinterpret_cast<uint8_t*>(conv),reinterpret_cast<uint8_t*>(fac),
      reinterpret_cast<uint8_t*>(indices),reinterpret_cast<uint8_t*>(output),
      sample_count,attempts);
}
